DATABASE_URL=sqlite:///./cropgrid.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CROPGRID_SEED_DEMO=true
# Optional: set both only when provisioning your private administrator account. Admin cannot self-register.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_LISTING_MODEL=gpt-4o-mini
# Optional Monnify integration. Use sandbox credentials for local testing.
MONNIFY_ENV=sandbox
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_CALLBACK_URL=http://localhost:3000/payment/return
